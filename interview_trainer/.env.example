# IBM watsonx.ai credentials
# Obtain these from your IBM Cloud watsonx.ai project:
# 1. Go to https://cloud.ibm.com and create a Lite account
# 2. Navigate to watsonx.ai (https://dataplatform.cloud.ibm.com)
# 3. Create a new project and note the Project ID
# 4. Generate an API key at https://cloud.ibm.com/iam/apikeys
# 5. The service URL depends on your region (e.g. us-south, eu-de)

WATSONX_API_KEY=YOUR_NEW_API_KEY_HERE
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=YOUR_PROJECT_ID_HERE

# Optional: override the default Granite model
# Uncomment and set to the model available in your watsonx.ai project:
WATSONX_MODEL_ID=ibm/granite-4-h-small
